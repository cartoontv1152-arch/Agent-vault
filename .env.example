# Required for signed login sessions. Run `npm run setup` to generate it locally.
SESSION_SECRET=

# Optional locally (SQLite is used when omitted). Required on serverless hosts such
# as Vercel so application records persist between function invocations.
DATABASE_URL=

# Public 0G Galileo defaults. Override only when the official network changes.
NEXT_PUBLIC_OG_CHAIN_ID=16602
NEXT_PUBLIC_OG_RPC_URL=https://evmrpc-testnet.0g.ai
NEXT_PUBLIC_OG_EXPLORER_URL=https://chainscan-galileo.0g.ai
NEXT_PUBLIC_OG_STORAGE_EXPLORER_URL=https://storagescan-galileo.0g.ai
NEXT_PUBLIC_ERC8004_IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e

# 0G Storage. `auto` uses 0G when a service key exists and honest local encrypted
# storage otherwise. Use `og` in deployed environments to fail closed.
STORAGE_MODE=auto
OG_STORAGE_PRIVATE_KEY=
OG_STORAGE_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai
OG_STORAGE_TIMEOUT_MS=120000

# 0G Compute Router. Create a testnet API key at https://pc.testnet.0g.ai.
OG_COMPUTE_API_URL=https://router-api-testnet.integratenetwork.work/v1
OG_COMPUTE_API_KEY=
OG_COMPUTE_MODEL=
OG_COMPUTE_TIMEOUT_MS=60000

# Public app origin used in SIWE messages and agent registration metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000
